# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (no +, no spaces). PLACEHOLDER — replace.
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_CONTACT_EMAIL=hello@elarajourneys.com

# --- Database (PostgreSQL: local, Neon, Supabase, Vercel Postgres) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elarajourneys

# --- Payments: Midtrans Snap (use sandbox keys while developing) ---
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Email reminders (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Elara Journeys <trips@elarajourneys.com>"

# --- Security ---
# Long random string, e.g. `openssl rand -base64 32`
ADMIN_PASSWORD=
SESSION_SECRET=
# Shared secret the cron caller must send as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
